// Reglas de Firestore para Nadia y Luis.
//
// IMPORTANTE: este archivo está en un repositorio PÚBLICO, así que aquí NO van
// los correos de verdad. Pégalo en Firebase (Firestore Database > Reglas) y ahí
// cambia EMAIL_DE_LUIS y EMAIL_DE_NADIA por los dos correos, en minúsculas.
// Los correos reales solo deben vivir en la consola de Firebase.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo pasan las dos cuentas (y con sesión iniciada)
    function esDeLosDos() {
      return request.auth != null
        && request.auth.token.email in ['EMAIL_DE_LUIS', 'EMAIL_DE_NADIA'];
    }

    // Quién es quién (Nadia o Luis). Cada quien escribe solo el suyo.
    match /usuarios/{uid} {
      allow read: if esDeLosDos();
      allow write: if esDeLosDos() && request.auth.uid == uid;
    }

    // Buzón de notas
    match /buzon/{id} {
      allow read: if esDeLosDos();
      allow create: if esDeLosDos()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 1500;
      allow delete: if esDeLosDos() && resource.data.uid == request.auth.uid;
    }

    // “Estoy pensando en ti”
    match /pienso/{uid} {
      allow read: if esDeLosDos();
      allow write: if esDeLosDos() && request.auth.uid == uid;
    }

    // Respuestas de la pregunta del día (el id es  AAAA-MM-DD_uid)
    match /respuestas/{id} {
      allow read: if esDeLosDos();
      allow create, update: if esDeLosDos()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 1200;
      allow delete: if esDeLosDos() && resource.data.uid == request.auth.uid;
    }

    // Lista de sueños compartida
    match /compartido/{doc} {
      allow read, write: if esDeLosDos();
    }

    // Todo lo demás, cerrado
    match /{otro=**} {
      allow read, write: if false;
    }
  }
}
